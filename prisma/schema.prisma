generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  // Optional for participants (email-only auth)
  fullName     String
  phone        String?
  role         String   @default("PARTICIPANT") // Comma-separated roles if multiple (e.g. "ADMIN,FOLLOW_UP" or "PARTICIPANT")
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile             Profile?
  completions         TaskCompletion[]
  streak              Streak?
  assignedFollowUps   FollowUpAssignment[] @relation("AssignedFollowUp")
  managedParticipants FollowUpAssignment[] @relation("ManagedParticipants")
  notesWritten        FollowUpNote[]       @relation("AuthorNotes")
  notesReceived       FollowUpNote[]       @relation("TargetNotes")
  testimonials        Testimonial[]
  personalTasks       ParticipantPersonalTask[]
  dailyJournalNotes   DailyJournalNote[]
  feedbacks           Feedback[]
  pollVotes           PollVote[]
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthday     String?
  ageRange     String?
  goals        String?  @db.Text
  expectations String?  @db.Text
  customAnswers String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Programme {
  id          String           @id @default(uuid())
  title       String
  description String?          @db.Text
  startDate   String           // Format: YYYY-MM-DD e.g. "2026-09-27"
  isActive    Boolean          @default(true)
  isLive      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  phases ProgrammePhase[]
}

model ProgrammePhase {
  id           String          @id @default(uuid())
  programmeId  String
  programme    Programme       @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  title        String          // e.g. "RESET", "RESTART", "REFOCUS"
  phaseNumber  Int             // 1, 2, 3
  durationDays Int             @default(30)
  objective    String?         @db.Text
  isUnlocked   Boolean         @default(true)
  createdAt    DateTime        @default(now())

  weeks ProgrammeWeek[]
}

model ProgrammeWeek {
  id             String         @id @default(uuid())
  phaseId        String
  phase          ProgrammePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  weekNumber     Int            // 1, 2, 3, 4
  theme          String         // e.g. "Reset Your Mindset"
  objective      String?        @db.Text
  keyAreas       String?        @db.Text
  anchorResource String?        // e.g. "Mindset by Carol Dweck"

  days ProgrammeDay[]
}

model ProgrammeDay {
  id        String        @id @default(uuid())
  weekId    String
  week      ProgrammeWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNumber Int           // 1..90
  dayOfWeek String?       // "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"
  title     String?       // e.g. "Day 1: Pausing Friction"
  focus     String?       @db.Text

  tasks Task[]
}

model Resource {
  id               String   @id @default(uuid())
  title            String
  type             String   // BIBLE, BOOK, PODCAST, SERMON, VIDEO, ARTICLE, DOCUMENT, EXTERNAL_LINK
  author           String?
  url              String?
  fileUrl          String?  // Softcopy upload URL or data URL
  fileName         String?  // Original filename e.g. Mindset_Carol_Dweck.pdf
  accessType       String?  @default("LINK") // "LINK" or "FILE"
  contentNotes     String?  @db.Text
  isAutoIncrement  Boolean  @default(false)
  startUnit        Int?     @default(1)
  unitsPerDay      Int?     @default(3)
  unitType         String?  @default("CHAPTERS") // "CHAPTERS" or "PAGES"
  bookName         String?  // e.g. "Matthew" or "Genesis" or "Mindset"
  bibleVersion     String?  @default("KJV")
  bibleUrlTemplate String?  // e.g. https://bible.com/bible/1/mat.2.1.kjv
  createdAt        DateTime @default(now())

  tasks Task[]
}

model TaskTemplate {
  id                     String   @id @default(uuid())
  title                  String
  description            String?  @db.Text
  taskType               String   @default("GROWTH") // NON_NEGOTIABLE, GROWTH, LEARNING, COMMUNITY, PERSONAL, EVENT
  pillar                 String   @default("SPIRITUAL") // SPIRITUAL, MENTAL, SOCIAL
  timeOfDay              String?  @default("ANYTIME") // ANYTIME, MORNING, AFTERNOON, NIGHT
  defaultRequired        Boolean  @default(true)
  defaultDurationMinutes Int      @default(15)
  iconCategory           String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())

  tasks Task[]
}

model Task {
  id                   String        @id @default(uuid())
  dayId                String?
  day                  ProgrammeDay? @relation(fields: [dayId], references: [id], onDelete: SetNull)
  templateId           String?
  template             TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  resourceId           String?
  resource             Resource?     @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  title                String
  description          String        @db.Text
  taskType             String        @default("GROWTH") // NON_NEGOTIABLE, GROWTH, LEARNING, COMMUNITY, PERSONAL, EVENT
  pillar               String        // SPIRITUAL, SOCIAL, MENTAL
  timeOfDay            String?       @default("ANYTIME") // ANYTIME, MORNING, AFTERNOON, NIGHT
  category             String?
  frequencyType        String        @default("DAILY") // DAILY, WEEKLY, BIWEEKLY, MONTHLY, ONE_TIME, RECURRING
  isNonNegotiable      Boolean       @default(false)
  isOptional           Boolean       @default(false)
  isRequired           Boolean       @default(true)
  dayNumber            Int?
  weekNumber           Int?
  startDate            String?
  endDate              String?
  pageRange            String?       // e.g. "Chapter 2, pp. 15–30"
  timestampRange       String?       // e.g. "12:30 – 28:40"
  resourceUrl          String?
  fileUrl              String?
  fileName             String?
  instructions         String?       @db.Text
  discussionQuestions  String?       @db.Text
  durationMinutes      Int?          @default(15)
  isAutoIncrement      Boolean?      @default(false)
  startUnit            Int?
  unitsPerDay          Int?
  unitType             String?
  bookName             String?
  isActive             Boolean       @default(true)
  displayOrder         Int           @default(0)
  createdAt            DateTime      @default(now())

  completions TaskCompletion[]
  polls       Poll[]
}

model ParticipantPersonalTask {
  id              String   @id @default(uuid())
  participantId   String
  user            User     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  title           String
  category        String   @default("Personal")
  frequency       String   @default("DAILY")
  durationMinutes Int      @default(30)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model TaskCompletion {
  id             String   @id @default(uuid())
  participantId  String
  taskId         String
  completedAt    DateTime @default(now())
  completionDate String   // Format: YYYY-MM-DD
  notes          String?  @db.Text

  participant User @relation(fields: [participantId], references: [id], onDelete: Cascade)
  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([participantId, taskId, completionDate])
}

model Streak {
  id                String   @id @default(uuid())
  participantId     String   @unique
  user              User     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  totalCompleted    Int      @default(0)
  totalAssigned     Int      @default(0)
  overallPercentage Float    @default(0.0)
  lastCompletedDate String?
  isProtected       Boolean  @default(false)
  bonusStreak       Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model FollowUpAssignment {
  id            String   @id @default(uuid())
  followUpId    String
  participantId String
  assignedAt    DateTime @default(now())

  followUpMember User @relation("ManagedParticipants", fields: [followUpId], references: [id], onDelete: Cascade)
  participant    User @relation("AssignedFollowUp", fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([followUpId, participantId])
}

model FollowUpNote {
  id            String   @id @default(uuid())
  authorId      String
  participantId String
  noteContent   String   @db.Text
  createdAt     DateTime @default(now())

  author      User @relation("AuthorNotes", fields: [authorId], references: [id], onDelete: Cascade)
  participant User @relation("TargetNotes", fields: [participantId], references: [id], onDelete: Cascade)
}

model LeaderboardConfig {
  id         String   @id @default("global")
  isEnabled  Boolean  @default(true)
  showNames  Boolean  @default(true)
  metricType String   @default("CONSISTENCY_PERCENTAGE")
  updatedAt  DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  pillar      String
  eventDate   String
  resourceUrl String?
  createdAt   DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  isPublic    Boolean  @default(false)
  isApproved  Boolean  @default(false)
  submittedAt DateTime @default(now())
}

model DynamicForm {
  id          String   @id @default(uuid())
  title       String   // e.g. "Cohort Intake Questionnaire"
  description String?  @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields DynamicFormField[]
}

model DynamicFormField {
  id           String       @id @default(uuid())
  formId       String?
  form         DynamicForm? @relation(fields: [formId], references: [id], onDelete: Cascade)
  fieldName    String
  label        String
  fieldType    String       // text, select, textarea, multiselect, date
  isRequired   Boolean      @default(false)
  options      String?      @db.Text // JSON stringified options
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
}

model SystemSettings {
  id                        String   @id @default("global")
  isAdminRegistrationActive Boolean  @default(true)
  pillars                   String?  @db.Text
  updatedAt                 DateTime @updatedAt
}

model DailyJournalNote {
  id            String   @id @default(uuid())
  participantId String
  user          User     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  noteDate      String   // YYYY-MM-DD
  dayNumber     Int?
  content       String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([participantId, noteDate])
}

model Feedback {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String   @default("GENERAL") // GENERAL, BUG_REPORT, FEATURE_REQUEST, TASK_ISSUE, APP_EXPERIENCE
  subject       String
  message       String   @db.Text
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, DISMISSED
  adminResponse String?  @db.Text
  respondedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Poll {
  id            String       @id @default(uuid())
  question      String       @db.Text
  description   String?      @db.Text
  allowMultiple Boolean      @default(false)
  isStandalone  Boolean      @default(true)
  showAsPopup   Boolean      @default(false)
  taskId        String?
  programmeId   String?
  status        String       @default("ACTIVE") // ACTIVE, CLOSED, DRAFT
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  task    Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id           String     @id @default(uuid())
  pollId       String
  text         String
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
}

